# Forke Go Backend Environment Variables
PORT=8080
APP_ENV=development

# Database connection URL
DATABASE_URL=postgres://forke:forke_secret@localhost:5433/forke_dev?sslmode=disable

# JWT Secret for cross-domain auth
JWT_SECRET=forke-jwt-super-secret-key-replace-in-production

# Cookie domain (use .forke.space for cross-subdomain sharing in production, localhost in development)
COOKIE_DOMAIN=localhost

# Allowed CORS Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,https://forke.space,https://dashboard.forke.space,https://admin.forke.space
